         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>SUSTAINABILITY</photoshop:LayerName>
                  <photoshop:LayerText>SUSTAINABILITY</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Sembramos 10 mil ha anuales</photoshop:LayerName>
                  <photoshop:LayerText>Sembramos 10 mil ha anuales</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We incorporate more than 200 million tons of organic harvest wa</photoshop:LayerName>
                  <photoshop:LayerText>We incorporate more than 200 million tons of organic harvest waste into our fields.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Al campo se incorporan para su mejoramiento, 200 millones de to</photoshop:LayerName>
                  <photoshop:LayerText>Al campo se incorporan para su mejoramiento, 200 millones de toneladas de residuos de cosecha.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>3 mil toneladas de composta al a√±o</photoshop:LayerName>
                  <photoshop:LayerText>3 mil toneladas de composta al a√±o</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We generate in our own facilities 2,200 tons of organic compost</photoshop:LayerName>
                  <photoshop:LayerText>We generate in our own facilities 2,200 tons of organic compost.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Se genera composta con residuos de tomate y ajo. Adicional comp</photoshop:LayerName>
                  <photoshop:LayerText>Se genera composta con residuos de tomate y ajo. Adicional compramos sobre 600 toneladas a externos como huevo San Juan y SuCarne.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>No se esterilizan suelos.</photoshop:LayerName>
                  <photoshop:LayerText>No se esterilizan suelos.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We do organic farming on 1235 open crop acres and 118 greenhous</photoshop:LayerName>
                  <photoshop:LayerText>We do organic farming on 1235 open crop acres and 118 greenhouse acres, all CCOF certified.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We use 100% drip irrigation. This system allow us to save 70% o</photoshop:LayerName>
                  <photoshop:LayerText>We use 100% drip irrigation. This system allow us to save 70% of water.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Our packaging materials are 100% recyclable.</photoshop:LayerName>
                  <photoshop:LayerText>Our packaging materials are 100% recyclable.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Recuperaci√≥n de agua pluvial en invernaderos.</photoshop:LayerName>
                  <photoshop:LayerText>Recuperaci√≥n de agua pluvial en invernaderos.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Manejo integrado de plagas en el 100% de la superficie.</photoshop:LayerName>
                  <photoshop:LayerText>Manejo integrado de plagas en el 100% de la superficie.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Bee friendly farming.</photoshop:LayerName>
                  <photoshop:LayerText>Bee friendly farming.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Birational practices.  We reduced the use         of more than </photoshop:LayerName>
                  <photoshop:LayerText>Birational practices.  We reduced the use         of more than 220 tons of    chemical fertilizers in our fields.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Programa de manejo racional de suelo</photoshop:LayerName>
                  <photoshop:LayerText>Programa de manejo racional de suelo</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Full crop rotation program and other concrete actions that prot</photoshop:LayerName>
                  <photoshop:LayerText>Full crop rotation program and other concrete actions that protect soil from degradation and erosion.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName> A growing solar panel system allows us today to generate over </photoshop:LayerName>
                  <photoshop:LayerText> A growing solar panel system allows us today to generate over 650,000 kWh annually.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>19,177 square feet of solar panels installed = 588 tons of CO2 </photoshop:LayerName>
                  <photoshop:LayerText>19,177 square feet of solar panels installed = 588 tons of CO2 less emissions.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>588 tons of CO2 less emissions.</photoshop:LayerName>
                  <photoshop:LayerText>588 tons of CO2 less emissions.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>=</photoshop:LayerName>
                  <photoshop:LayerText>=</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>138,294 ft¬≤ of solar panels added.</photoshop:LayerName>
                  <photoshop:LayerText>138,294 ft¬≤ of solar panels added.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>800 trees planted, preventing emissions of 24 tons of CO2.</photoshop:LayerName>
                  <photoshop:LayerText>800 trees planted, preventing emissions of 24 tons of CO2.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Pr√°cticas de protecci√≥n a polinizadores.</photoshop:LayerName>
                  <photoshop:LayerText>Pr√°cticas de protecci√≥n a polinizadores.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>100% riego por goteo en campo</photoshop:LayerName>
                  <photoshop:LayerText>100% riego por goteo en campo</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>We reduce our footprint by nearly 4,000 tons of CO2 emissions y</photoshop:LayerName>
                  <photoshop:LayerText>We reduce our footprint by nearly 4,000 tons of CO2 emissions yearly.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>SUSTAINABILITY REPORT 2025</photoshop:LayerName>
                  <photoshop:LayerText>SUSTAINABILITY REPORT 2025</photoshop:LayerText>
               </rdf:li>
            </rdf:Bag>
         </photoshop:TextLayers>
