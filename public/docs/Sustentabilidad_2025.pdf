         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Incorporamos m√°s de 200 millones de toneladas de residuos org√°n</photoshop:LayerName>
                  <photoshop:LayerText>Incorporamos m√°s de 200 millones de toneladas de residuos org√°nicos a nuestros campos.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Al campo se incorporan para su mejoramiento, 200 millones de to</photoshop:LayerName>
                  <photoshop:LayerText>Al campo se incorporan para su mejoramiento, 200 millones de toneladas de residuos de cosecha.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>3 mil toneladas de composta al a√±o</photoshop:LayerName>
                  <photoshop:LayerText>3 mil toneladas de composta al a√±o</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Generamos en nuestras instalaciones 2,200 toneladas de composta</photoshop:LayerName>
                  <photoshop:LayerText>Generamos en nuestras instalaciones 2,200 toneladas de composta org√°nica.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Se genera composta con residuos de tomate y ajo. Adicional comp</photoshop:LayerName>
                  <photoshop:LayerText>Se genera composta con residuos de tomate y ajo. Adicional compramos sobre 600 toneladas a externos como huevo San Juan y SuCarne.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>No se esterilizan suelos.</photoshop:LayerName>
                  <photoshop:LayerText>No se esterilizan suelos.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>En 2025 aumentamos nuestra superficie total de agricultura org√°</photoshop:LayerName>
                  <photoshop:LayerText>En 2025 aumentamos nuestra superficie total de agricultura org√°nica a 548 hect√°reas.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>100% riego por goteo, logrando un ahorro de agua del 70%.</photoshop:LayerName>
                  <photoshop:LayerText>100% riego por goteo, logrando un ahorro de agua del 70%.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Nuestros materiales de empaque son 100% reciclables.</photoshop:LayerName>
                  <photoshop:LayerText>Nuestros materiales de empaque son 100% reciclables.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Recuperaci√≥n de agua pluvial en invernaderos.</photoshop:LayerName>
                  <photoshop:LayerText>Recuperaci√≥n de agua pluvial en invernaderos.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Manejo integrado de plagas en el 100% de la superficie.</photoshop:LayerName>
                  <photoshop:LayerText>Manejo integrado de plagas en el 100% de la superficie.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Pr√°cticas birracionales. Actualmente hemos reducido al menos un</photoshop:LayerName>
